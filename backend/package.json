{
  "name": "viet-fuel-api",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20 <25" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sync": "tsx src/scripts/sync.ts",
    "history:import": "tsx src/scripts/import-history.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0", "@types/compression": "^1.7.5", "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/node": "^22.18.0", "@types/supertest": "^6.0.3", "eslint": "^9.34.0", "globals": "^16.4.0", "prettier": "^3.6.2", "supertest": "^7.1.4", "tsx": "^4.20.5", "typescript": "^5.9.2", "typescript-eslint": "^8.42.0", "vitest": "^5.1.2"
  }
}
